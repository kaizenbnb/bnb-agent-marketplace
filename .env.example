# Agent wallet address (agentic smart account, testnet)
WALLET_ADDRESS=

# Admin private key (signer for Altana SDK admin path, testnet only, NEVER commit real value)
ADMIN_PRIVATE_KEY=

# No longer required: the Permit2 signature is now produced client-side by
# the buyer's own connected wallet (wagmi/RainbowKit), not signed server-side.
# Kept here only if some deployments still set it; harmless if unset.
X402_SESSION_SIGNER_KEY=

# WalletConnect Cloud Project ID (get one free at https://cloud.reown.com).
# Public by design (NEXT_PUBLIC_ prefix ships to the browser). Only needed for
# the WalletConnect QR connector; MetaMask/Binance Wallet/Trust Wallet work
# without it. Without a real value, RainbowKit falls back to a placeholder
# and shows a dev-mode "1 Issue" warning badge (harmless, dev-only).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
